TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=choose-any-random-string-and-reuse-it-when-setting-the-webhook
# Public HTTPS URL of this app, used by set_webhook.py (no trailing /webhook)
TELEGRAM_WEBHOOK_URL=
PORT=8080
LOG_LEVEL=INFO

# Comma-separated Telegram user IDs allowed to send /broadcast (see /whoami)
TELEGRAM_ADMIN_IDS=
TELEGRAM_RECIPIENTS_FILE=recipients.txt
# Alternative to the file above: comma-separated chat IDs, e.g. for pasting
# straight into a host's dashboard (Railway) instead of using a file. Wins
# over TELEGRAM_RECIPIENTS_FILE when set.
TELEGRAM_RECIPIENTS=
